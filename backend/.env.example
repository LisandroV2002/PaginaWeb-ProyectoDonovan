# Configuración de SIVAI — copiar a backend/.env y completar.
#
# TODAS las variables de esta sección son obligatorias: si falta alguna, la
# aplicación NO arranca y el mensaje de error dice cuál (hallazgo H-01).
# Antes tenían valores por defecto y una configuración ausente pasaba
# inadvertida hasta fallar en runtime.

# --- Base de datos PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=reader_user
DB_PASS=

# --- Estación agrometeorológica a monitorear ---
ID_ESTACION=85

# --- Opcionales ---

# Orígenes permitidos por CORS, separados por coma. Sólo hace falta si el
# frontend se sirve desde un origen distinto al del backend; en el despliegue
# normal el backend sirve /public, con lo que es same-origin.
# ALLOWED_ORIGINS=http://localhost:7777,http://127.0.0.1:7777

# Pone la Content-Security-Policy en modo observación: el navegador reporta las
# violaciones por consola pero no bloquea nada. Útil para la primera vuelta en
# producción; dejar en false (o sin definir) para que la política se aplique.
# CSP_REPORT_ONLY=false
